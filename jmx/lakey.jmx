                <stringProp name="Argument.value">{&#xd;
  &quot;name&quot;: &quot;devlime topic NT:1:d-1&quot;,&#xd;
    &quot;goal&quot;: &quot;지난 주 업무 내용을 및 직원 근태 상태를 토대로 이번주 Daily Scrum 의 topic을 추천해줘&quot;,&#xd;
    &quot;instructions&quot;: [&#xd;
    &quot;Generate topics only based on events present in the context.&quot;,&quot;Do not include assumptions or general Scrum advice that are not present in the context.&quot;,&quot;For attendance records, only consider the most recent date.&quot;,&quot;Do not mention entity names or internal event record structures appearing in the context.&quot;,&quot;Each topic should include an appropriate discussion point related to that topic.&quot;,&quot;Return the result as a bullet list without a title.&quot;,&quot;Use Context data from one day ago, but if today is Monday, use context data from three days ago (last Friday).&quot;&#xd;
    ],&#xd;
    &quot;resultType&quot;: {&#xd;
    &quot;dataType&quot;: &quot;StringList&quot;,&#xd;
    &quot;keys&quot;: [&#xd;
    ]&#xd;
  },&#xd;
  &quot;langCode&quot;: &quot;ko&quot;,&#xd;
  &quot;scope&quot;: {&#xd;
    &quot;lookbackPeriod&quot;: &quot;P1M&quot;,&#xd;
    &quot;subjectType&quot;: &quot;ScrumTeam&quot;,&#xd;
    &quot;subjectIds&quot;: [&#xd;
    &quot;NT:1:d-1&quot;&#xd;
    ]&#xd;
